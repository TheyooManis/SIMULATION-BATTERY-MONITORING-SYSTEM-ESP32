<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <meta
      name="description"
      content="Dashboard monitoring battery bank DC UPS berbasis IoT dengan ESP32 dan MQTT real-time."
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              dark: "#08090e",
              surface: "#111422",
              card: "#161b26",
              border: "#1e2740",
              accent: "#00e5ff",
              good: "#00e676",
              warn: "#ff9100",
              crit: "#ff1744",
            },
            fontFamily: {
              sans: ["Outfit", "sans-serif"],
              mono: ["JetBrains Mono", "monospace"],
            },
            boxShadow: {
              glow: "0 0 20px rgba(0,229,255,0.15)",
            },
          },
        },
      };
    </script>

    <style>
      /* Scrollbar */
      ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
      }
      ::-webkit-scrollbar-track {
        background: #111422;
      }
      ::-webkit-scrollbar-thumb {
        background: #1e2740;
        border-radius: 4px;
      }

      /* SweetAlert dark theme override */
      .swal2-popup {
        background: #161b26 !important;
        color: #f8fafc !important;
        border: 1px solid #1e2740 !important;
        border-radius: 16px !important;
      }
      .swal2-title {
        color: #00e5ff !important;
      }
      .swal2-select,
      .swal2-input {
        background: #0d1117 !important;
        border: 1px solid #1e2740 !important;
        color: #f8fafc !important;
        border-radius: 8px !important;
      }
      .swal2-confirm {
        background: linear-gradient(135deg, #00e5ff, #7c3aed) !important;
        color: #000 !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
      }
      .swal2-cancel {
        background: #1e2740 !important;
        color: #94a3b8 !important;
        border-radius: 8px !important;
      }
    </style>
    <!-- SweetAlert2 -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>

  <body class="text-gray-100 font-sans min-h-screen flex flex-col bg-dark">
    <!-- ═══════════════════════ HEADER ═══════════════════════ -->
    <header
      class="bg-card border-b border-border sticky top-0 z-20 backdrop-blur-md"
    >
      <div
        class="max-w-screen-2xl mx-auto px-4 py-3 flex flex-wrap items-center gap-3"
      >
        <!-- Logo + Title -->
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <div
            class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent to-purple-600 flex items-center justify-center text-black font-extrabold text-sm shrink-0"
          >
            ⚡
          </div>
          <div class="min-w-0">
            <h1
              class="text-sm md:text-base font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-accent to-purple-400 leading-tight truncate"
            >
              BATTERY BANK MONITOR
            </h1>
            <p class="text-xs text-gray-500 hidden sm:block">
              PLTU – IoT Dashboard berbasis ESP32 & MQTT
            </p>
          </div>
        </div>

        <!-- Status Indicators -->
        <div class="flex items-center gap-2 flex-wrap">
          <!-- Settings Button -->
          <button
            id="btn-settings"
            class="flex items-center gap-1.5 bg-surface border border-border text-gray-300 font-bold text-xs px-4 py-2 rounded-full hover:border-accent hover:text-accent transition-all"
          >
            ⚙️ Settings
          </button>
          <!-- Add Battery Button -->
          <button
            id="btn-show-config"
            class="flex items-center gap-1.5 bg-gradient-to-r from-accent to-purple-600 text-black font-bold text-xs px-4 py-2 rounded-full hover:opacity-90 transition-all shadow-glow"
          >
            ＋ Tambah Battery
          </button>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════ MAIN ═══════════════════════ -->
    <main class="flex-1 max-w-screen-2xl mx-auto w-full px-4 py-5">
      <!-- Top row: Status + Sensor + MQTT -->
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-4">
        <!-- STATUS CARD -->
        <div
          id="dashboard-status-card"
          class="bg-card border-[1.5px] rounded-2xl p-4 flex flex-col gap-2 transition-all border-good shadow-[0_0_16px_rgba(0,230,118,0.2)]"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-xs font-bold uppercase text-gray-500 tracking-wider"
              >Status Sistem</span
            >
            <span
              id="status-badge-text"
              class="text-xs font-bold px-3 py-1 rounded-full bg-[#00e67626] text-good border border-[#00e6764d]"
              >✅ NORMAL</span
            >
          </div>
          <div id="alerts-list" class="space-y-1">
            <div
              id="missing-cells-info"
              class="hidden text-xs text-red-400 font-medium"
            ></div>
            <p class="text-xs text-good">✔ Semua parameter dalam batas aman.</p>
          </div>
        </div>

        <!-- SENSOR READINGS -->
        <div class="bg-card border border-border rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <span
              class="text-xs font-bold uppercase text-gray-500 tracking-wider"
              >Data Sensor ESP32</span
            >
            <span id="last-update-time" class="text-xs text-gray-500"
              >Belum ada data</span
            >
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div class="bg-surface rounded-xl p-2 text-center">
              <span class="block text-xs text-gray-500 mb-1">⚡ Tegangan</span>
              <span
                class="block text-accent font-mono font-bold text-sm"
                id="disp-voltage"
                >--- V</span
              >
            </div>
            <div class="bg-surface rounded-xl p-2 text-center">
              <span class="block text-xs text-gray-500 mb-1">🌡 Suhu</span>
              <span
                class="block text-warn font-mono font-bold text-sm"
                id="disp-temp"
                >--- °C</span
              >
            </div>
            <div class="bg-surface rounded-xl p-2 text-center">
              <span class="block text-xs text-gray-500 mb-1">⚙️ Arus</span>
              <span
                class="block text-yellow-400 font-mono font-bold text-sm"
                id="disp-current"
                >--- A</span
              >
            </div>
          </div>
        </div>

        <!-- MQTT INFO -->
        <div
          class="bg-card border border-border rounded-2xl p-4 sm:col-span-2 xl:col-span-1"
        >
          <span
            class="text-xs font-bold uppercase text-gray-500 tracking-wider block mb-3"
            >Info Koneksi MQTT</span
          >
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between">
              <span class="text-gray-500">Broker</span
              ><span id="info-broker" class="font-mono text-gray-300"
                >HIDDEN</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-gray-500">Status Broker</span
              ><span id="info-broker-status" class="font-mono"
                >Menghubungkan...</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Log + Table stacked -->
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-4">
          <!-- LOG -->
          <div
            class="bg-card border border-border rounded-2xl p-3 flex flex-col h-48 sm:h-56"
          >
            <div class="flex items-center justify-between mb-2">
              <span
                class="text-xs font-bold uppercase text-gray-500 tracking-wider"
              >
                Log Aktivitas & Alarm
              </span>
              <button
                id="btn-clear-logs"
                class="text-[10px] bg-red-500/10 border border-red-500/30 hover:border-red-500 text-red-400 hover:text-red-300 px-2 py-0.5 rounded-md transition-colors"
              >
                🗑 Hapus Logs
              </button>
            </div>
            <div
              id="log-console"
              class="flex-1 min-h-0 overflow-y-auto font-mono text-xs bg-surface rounded-lg p-2 space-y-0.5"
            ></div>
          </div>

          <!-- TABLE -->
          <div
            class="bg-card border border-border rounded-2xl p-3 flex flex-col h-48 sm:h-56"
          >
            <div class="flex items-center justify-between mb-2">
              <span
                class="text-xs font-bold uppercase text-gray-500 tracking-wider"
                >Riwayat Pengukuran</span
              >
              <div class="flex gap-2">
                <button
                  id="btn-clear-history"
                  class="text-[10px] bg-red-500/10 border border-red-500/30 hover:border-red-500 text-red-400 hover:text-red-300 px-2 py-1 rounded-md transition-colors"
                >
                  🗑 Hapus Riwayat
                </button>
              </div>
            </div>
            <div class="flex-1 min-h-0 overflow-auto">
              <table class="w-full text-xs" id="measurements-table">
                <thead class="sticky top-0 bg-surface text-gray-400">
                  <tr>
                    <th class="p-1 text-left">Jam</th>
                    <th class="p-1 text-left">Sel</th>
                    <th class="p-1 text-right">Volt</th>
                    <th class="p-1 text-right">Suhu</th>
                    <th class="p-1 text-right">Arus</th>
                    <th class="p-1 text-center">Status</th>
                  </tr>
                </thead>
                <tbody id="measurements-tbody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- CELL GRID PANEL -->
      <div id="cell-panel" class="hidden">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div>
            <h2 class="text-sm font-bold text-accent uppercase tracking-wider">
              Monitoring Sel Baterai
            </h2>
            <p id="cell-config-info" class="text-xs text-gray-500">
              Menunggu data...
            </p>
          </div>
          <!-- Legend -->
          <div class="flex items-center gap-3 text-xs text-gray-400">
            <span class="flex items-center gap-1"
              ><span class="w-2.5 h-2.5 rounded-sm bg-good inline-block"></span
              >Normal</span
            >
            <span class="flex items-center gap-1"
              ><span class="w-2.5 h-2.5 rounded-sm bg-warn inline-block"></span
              >Warning</span
            >
            <span class="flex items-center gap-1"
              ><span class="w-2.5 h-2.5 rounded-sm bg-crit inline-block"></span
              >Kritis</span
            >
            <span class="flex items-center gap-1"
              ><span
                class="w-2.5 h-2.5 rounded-sm bg-gray-600 inline-block"
              ></span
              >Offline</span
            >
          </div>
        </div>
        <div
          id="cell-grid-wrapper"
          class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 xl:grid-cols-12 gap-2"
        ></div>
      </div>
    </main>

    <!-- ═══════════════════════ CELL DETAIL MODAL ═══════════════════════ -->
    <div
      id="cell-modal"
      class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4"
    >
      <div
        class="bg-card border border-border rounded-2xl w-full max-w-sm shadow-2xl"
      >
        <!-- Header -->
        <div
          class="flex items-center justify-between px-5 py-4 border-b border-border"
        >
          <h3 class="font-bold text-accent" id="cell-modal-title">
            DETAIL SEL
          </h3>
          <button
            id="btn-cell-close"
            class="text-gray-400 hover:text-white text-xl leading-none"
          >
            &times;
          </button>
        </div>
        <!-- Body -->
        <div class="px-5 py-5 space-y-4 text-sm">
          <!-- Info Row -->
          <div class="flex items-center justify-between">
            <span id="cd-id" class="font-bold text-gray-100 text-lg"></span>
            <span id="cd-status" class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-surface border border-border text-center min-w-[80px]"></span>
          </div>

          <!-- Token -->
          <div class="flex flex-col gap-1.5">
            <span class="text-[10px] uppercase text-gray-500 font-bold tracking-wider">Authentication Token</span>
            <span
              id="cd-token"
              class="font-mono text-[11px] text-purple-400 bg-[#111422] p-2.5 rounded-lg border border-border select-all break-all text-center tracking-wider"
            ></span>
          </div>

          <!-- Metrics Grid -->
          <div class="grid grid-cols-2 gap-3 mt-2">
            <div class="bg-surface rounded-xl p-3 border border-border flex flex-col items-center justify-center relative overflow-hidden group hover:border-accent transition-colors">
              <div class="absolute inset-0 bg-accent/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <span class="text-[10px] text-gray-500 uppercase tracking-widest mb-1 relative z-10">Tegangan</span>
              <span id="cd-voltage" class="font-mono text-accent font-bold text-lg relative z-10"></span>
            </div>
            <div class="bg-surface rounded-xl p-3 border border-border flex flex-col items-center justify-center relative overflow-hidden group hover:border-yellow-400 transition-colors">
              <div class="absolute inset-0 bg-yellow-400/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <span class="text-[10px] text-gray-500 uppercase tracking-widest mb-1 relative z-10">Arus</span>
              <span id="cd-current" class="font-mono text-yellow-400 font-bold text-lg relative z-10"></span>
            </div>
            <div class="bg-surface rounded-xl p-3 border border-border flex flex-col items-center justify-center relative overflow-hidden group hover:border-warn transition-colors">
              <div class="absolute inset-0 bg-warn/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <span class="text-[10px] text-gray-500 uppercase tracking-widest mb-1 relative z-10">Suhu</span>
              <span id="cd-temp" class="font-mono text-warn font-bold text-lg relative z-10"></span>
            </div>
            <div class="bg-surface rounded-xl p-3 border border-border flex flex-col items-center justify-center relative overflow-hidden group hover:border-blue-400 transition-colors">
              <div class="absolute inset-0 bg-blue-400/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <span class="text-[10px] text-gray-500 uppercase tracking-widest mb-1 relative z-10">Water Level</span>
              <span id="cd-water" class="font-mono text-blue-400 font-bold text-lg relative z-10"></span>
            </div>
          </div>

          <hr class="border-border border-dashed my-3" />

          <!-- Details -->
          <div class="space-y-2.5">
            <div class="flex justify-between items-center text-xs">
              <span class="text-gray-500 font-medium flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>Terakhir Update</span>
              <span id="cd-lastseen" class="font-mono text-gray-300"></span>
            </div>
            <div class="flex justify-between items-center text-xs">
              <span class="text-gray-500 font-medium flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-accent"></span>Nominal Voltage</span>
              <span id="cd-nominal" class="font-mono text-gray-300"></span>
            </div>
            <div class="flex justify-between items-center text-xs">
              <span class="text-gray-500 font-medium flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>Tipe Baterai</span>
              <span id="cd-type" class="text-gray-200 font-semibold max-w-[150px] truncate text-right"></span>
            </div>
            
            <div class="bg-[#111422] p-3.5 rounded-xl border border-border mt-3 relative overflow-hidden">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-purple-500 to-accent"></div>
              <span class="text-[10px] text-gray-400 uppercase tracking-wider block mb-1.5 font-bold">Karakteristik</span>
              <span id="cd-char" class="text-gray-300 text-xs leading-relaxed block font-medium"></span>
            </div>
          </div>
        </div>
        <!-- Footer -->
        <div
          class="px-5 py-3 border-t border-border flex justify-between items-center"
        >
          <button
            id="btn-cell-delete"
            class="bg-red-500/10 border border-red-500/30 hover:border-red-500 text-red-400 hover:text-red-300 px-4 py-1.5 rounded-lg text-sm transition-colors flex items-center gap-2"
          >
            🗑 Hapus
          </button>
          <div class="flex gap-2">
            <button
              id="btn-cell-reset"
              class="bg-yellow-500/10 border border-yellow-500/30 hover:border-yellow-400 text-yellow-400 hover:text-yellow-300 px-4 py-1.5 rounded-lg text-sm transition-colors flex items-center gap-2"
            >
              ↺ Reset/Zero
            </button>
            <button
              id="btn-cell-ok"
              class="bg-surface border border-border hover:border-accent text-gray-300 hover:text-accent px-5 py-1.5 rounded-lg text-sm transition-colors"
            >
              Tutup
            </button>
          </div>
        </div>
      </div>
    </div>

    <script src="script.js"></script>
  </body>
</html>
